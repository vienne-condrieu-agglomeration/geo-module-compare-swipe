{
  "name": "geo-compare-swipe",
  "version": "0.3.2",
  "description": "Module GEO de comparaison de rasters (rideau et loupe) directement sur la carte principale, basé sur ol-ext",
  "main": "src/js/extension.js",
  "devDependencies": {
    "archiver": "^5.3.1",
    "css-loader": "^3.2.0",
    "raw-loader": "^4.0.2",
    "style-loader": "^1.0.0",
    "webpack": "^4.42.1",
    "webpack-cli": "^3.3.10"
  },
  "scripts": {
    "build": "webpack",
    "watch": "webpack --watch",
    "package": "npm run check:version && npm run build && node scripts/package.js",
    "publish": "webpack --config webpack.publish.config.js",
    "publish:watch": "webpack --watch --config webpack.publish.config.js",
    "test": "npm run check:version && node test/changelog.test.mjs",
    "check:version": "node scripts/check-version.js"
  },
  "keywords": [
    "geo",
    "swipe",
    "comparaison",
    "ol-ext",
    "orthophoto"
  ],
  "author": "fallamanche@vienne-condrieu-agglomeration.fr",
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "ol-ext": "4.0.38"
  }
}
